PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/toflymedia

JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

FILE_STORAGE=local
LOCAL_UPLOAD_PATH=uploads/

CLIENT_URL=http://localhost:5173


# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave blank to disable email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Flowdesk <your_email@gmail.com>"

# ── WhatsApp (Twilio) ─────────────────────────────────────────────────────────
# Leave blank to disable WhatsApp sending
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Must be the Twilio WhatsApp sender number e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886


# ══════════════════════════════════════════════════════════════════════════════
#  UNIFIED FLOWDESK — added for the integrated Attendance and Revenue & Finance
#  modules. Everything ABOVE this line is the original Flowdesk configuration and
#  is unchanged in name and meaning (MONGODB_URI is still Flowdesk's own database).
# ══════════════════════════════════════════════════════════════════════════════

# ── Existing Flowdesk variable that was used in code but not listed above ──────
# Groq-powered assistant. Leave blank to disable the AI assistant.
GROQ_API_KEY=

# ── INDEPENDENT MODULE DATABASES ───────────────────────────────────────────────
# Each module keeps its OWN database. Paste the SAME connection string the
# standalone app used. Never point two of these (or MONGODB_URI) at the same
# database: the server refuses to start that module if they match.
# If a variable is blank the module is disabled (its API answers 503 naming the
# variable); Flowdesk keeps working and never falls back to another database.
#
# Attendance app database            (was MONGODB_URI in attendance-app/backend)
ATTENDANCE_MONGODB_URI=mongodb://localhost:27017/office_attendance_db
# To Fly Accountant database         (was MONGODB_URI in tofly-accountant/backend)
ACCOUNTANT_MONGODB_URI=mongodb://localhost:27017/revenue-pwa

# Exit at boot if a module database is not configured / reachable (default: false)
STRICT_MODULE_DBS=false

# ── Attendance: web-push notifications (optional) ─────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# Reuse the keys of the existing attendance deployment so current browser
# subscriptions keep working.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-company.com

# ── Attendance: geofence (backend-enforced on every check-in/out) ─────────────
OFFICE_LATITUDE=23.2310465
OFFICE_LONGITUDE=77.442858
OFFICE_RADIUS_METERS=200

# ── Attendance: opt-in behaviours that existed in the standalone app ──────────
# DESTRUCTIVE: delete attendance records dated before 2026-04-01 at startup.
# The standalone app did this on every boot; it is OFF unless you set true.
ATTENDANCE_RETENTION_CLEANUP=false
# Render keep-alive self-ping (needs BACKEND_URL). Not needed in the unified app.
ATTENDANCE_KEEPALIVE_PING=false
# BACKEND_URL=https://your-api-host

# ── Who may do what (comma-separated Flowdesk roles; the client role is never allowed)
# Defaults are least-privilege.
#   ATTENDANCE_ACCESS_ROLES   use attendance as an employee   (default: every internal role)
#   ATTENDANCE_ADMIN_ROLES    administer attendance           (default: admin)
#   FINANCE_VIEW_ROLES        READ finance data               (default: admin)
#   FINANCE_WRITE_ROLES       create/edit/delete finance data (default: admin; implies view)
#   IDENTITY_ADMIN_ROLES      manage identity links           (default: admin)
# ATTENDANCE_ADMIN_ROLES=admin
# FINANCE_VIEW_ROLES=admin
# FINANCE_WRITE_ROLES=admin

# ── Identity matching (Flowdesk user -> attendance user) ──────────────────────
# true (default): an exact e-mail match links the accounts automatically (the rule
# both original apps already used). false: ONLY explicit links made in
# Admin > Identity Links grant attendance access.
IDENTITY_EMAIL_FALLBACK=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Extra allowed browser origins, comma-separated (e.g. a staging front-end).
# CORS_EXTRA_ORIGINS=

# ── No longer used by the unified app (kept only by the standalone apps) ──────
# JWT_SECRET, JWT_EXPIRE, JWT_EXPIRES_IN  (attendance/accountant logins)
# ADMIN_EMAIL, ADMIN_PASSWORD             (accountant seed script — not shipped)
# FRONTEND_URL                            (attendance CORS — use CLIENT_URL)
