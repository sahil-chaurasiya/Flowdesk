PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/toflymedia

JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

FILE_STORAGE=local
LOCAL_UPLOAD_PATH=uploads/

CLIENT_URL=http://localhost:5173


# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave blank to disable email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Flowdesk <your_email@gmail.com>"

# ── WhatsApp (Twilio) ─────────────────────────────────────────────────────────
# Leave blank to disable WhatsApp sending
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Must be the Twilio WhatsApp sender number e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
